# try stats again on aggregated survey data

# aggregate data
time_area_aggregate <- time_area %>%
  group_by(buddy_pair, site, survey_direction, survey_method) %>%
  summarise(total_area_ag = sum(total_area),
            diff_min_ag = sum(diff_min)) %>%
  ungroup() %>%
  mutate(time_diff_area_ag = diff_min_ag/total_area_ag)

# build gamma model on aggregated data 
mod_q1e_gamma_ag <- glmmTMB(time_diff_area_ag ~ survey_method*survey_direction + 
                           (1|site) + (1|buddy_pair), 
                         data = time_area_aggregate, 
                         family = Gamma(link = "log"))    

plot(simulateResiduals(mod_q1e_gamma_ag)) # p value suggests poor fit 
testDispersion(mod_q1e_gamma_ag) #seems fine
summary(mod_q1e_gamma_ag)

#Now we want to generally compare the effect of method on survey effort so to do this using post-hoc comparisons while maintaining degrees of freedom we use emmeans with the simple function
emmean_simple_survey_method_time <- emmeans(mod_q1e_gamma_ag, pairwise ~ c(survey_method, survey_direction), simple = "survey_method")
emmean_simple_survey_method_time
#back transfer the results manually (remove negative to change direction of effect (i.e., quads compared to belts))
exp(1.25) #belt par - quad par = 3.490343 times more min per unit area survey in quads
exp(1.35) #belt perp - quad perp = 3.857426 times more min per unit area survey in quads

