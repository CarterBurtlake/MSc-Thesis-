#Em's Wizardry 
pair_backtrans <- function(emmean_df){
  backtrans1 <- emmean_df$emmeans %>% 
    as.data.frame() %>% 
    mutate(trans = exp(emmean)) %>%
    unite("method", survey_direction, survey_method, sep = "_") %>%
    dplyr::select(method, trans)
  
  backtrans2 <- backtrans1 %>%
    crossing(
      backtrans1 %>%
        rename(method_2 = method,
               trans_2= trans)) %>%
    filter(method != method_2) %>%
    mutate(diff = trans - trans_2,
           abs_diff = abs(diff)) %>%
    distinct(abs_diff, .keep_all = TRUE) %>%
    dplyr::select(method, method_2, diff)
}

