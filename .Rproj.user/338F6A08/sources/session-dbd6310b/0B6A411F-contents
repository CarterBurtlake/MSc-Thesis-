emmean_simple_survey_direction_time
#back transfer the results manually (remove negative to change direction of effect (i.e., quads compared to belts))
exp(0.298) #belt par - belt perp = 1.347162 times more min per unit area survey in quads
exp(0.202) #quad par - quad perp = 1.223848 times more min per unit area survey in quads

